{
    "metadata": [
        {
            "id": "location_metadata",
            "path": "location",
            "fields": [
                {
                    "path": "address",
                    "fields": [
                        { "name": "postcode", "path": "zip" },
                        "place",
                        "latitude",
                        "longitude"
                    ]
                }
            ]
        }
    ]
}
