{
    "lookup": [
        {
            "id": "validated_zip_lookup",
            "metadata_id": "postcode_metadata",
            "data_id": "zip_data",
            "inputs": [
                {
                    "name": "postcode",
                    "expr": "${postcode:replaceAll('-.*', '')}",
                    "required": true,
                    "pattern": "[0-9]{5}"
                }
            ],
            "outputs": ["place", "latitude", "longitude"]
        }
    ]
}
