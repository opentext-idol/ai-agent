{
    "lookup": [
        {
            "id": "us_zip_to_place",
            "metadata_id": "postcode_metadata",
            "data_id": "zip_data",
            "inputs": [
                { "name": "country", "expr": "${literal('US')}", "required": true, "pattern": ".+" },
                { "name": "postcode", "expr": "${postcode:replaceAll('-.*', '')}", "required": true, "pattern": ".+" }
            ],
            "outputs": ["place", "latitude", "longitude"]
        }
    ]
}
