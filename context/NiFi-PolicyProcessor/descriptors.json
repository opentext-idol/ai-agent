    "route-by-metadata": {
        "displayName": "route-by-metadata",
        "description": "Transfers the FlowFile to one relationship when a metadata field matches a pattern, otherwise to another. Matches if any node selected by the field path satisfies the comparison.",
        "category": "Routing",
        "advanced": false,
        "configDescriptors": {
            "field-path": {
                "name": "field-path",
                "valueType": "Policy",
                "isList": false,
                "isRequired": true,
                "assignedContextObjects": {
                },
                "policyResultType": [
                    "java.lang.String",
                    "java.lang.Object"
                ],
                "isHidden": false,
                "description": "XPath of the metadata field(s) to test, e.g. \"DRECONTENT\" or \"//author\"."
            },
            "mode": {
                "name": "mode",
                "valueType": "String",
                "isList": false,
                "isRequired": false,
                "defaultJson": "equals",
                "isHidden": false,
                "description": "How the field value is compared with the pattern.",
                "allowedValues": [
                    "equals",
                    "contains",
                    "regex"
                ]
            },
            "pattern": {
                "name": "pattern",
                "valueType": "Policy",
                "isList": false,
                "isRequired": true,
                "assignedContextObjects": {
                },
                "policyResultType": [
                    "java.lang.String",
                    "java.lang.Object"
                ],
                "isHidden": false,
                "description": "Value to compare against. A literal for 'equals'/'contains', a regular expression for 'regex'."
            },
            "match-relationship": {
                "name": "match-relationship",
                "valueType": "String",
                "isList": false,
                "isRequired": false,
                "defaultJson": "matched",
                "isHidden": false,
                "description": "Relationship the FlowFile is transferred to when the field matches.",
                "isRelationship": true
            },
            "else-relationship": {
                "name": "else-relationship",
                "valueType": "String",
                "isList": false,
                "isRequired": false,
                "defaultJson": "success",
                "isHidden": false,
                "description": "Relationship the FlowFile is transferred to when the field does not match.",
                "isRelationship": true
            }
        },
        "requiredContextObjects": {
            "flowfile": [
                "org.apache.nifi.flowfile.FlowFile"
            ],
            "document": [
                "idol.nifi.framework.document.Document",
                "java.lang.Object"
            ]
        },
        "resultType": [
            "void"
        ]
    },
