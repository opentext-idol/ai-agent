    "for-each-flowfile": {
        "displayName": "for-each-flowfile",
        "description": "Processes a batch of FlowFiles, running 'do' for each with the FlowFile in scope. A FlowFile not transferred or removed by 'do' is transferred to the terminal relationship. Wrap 'do' in 'try' to isolate a single FlowFile's failure; otherwise an error rolls back the whole batch.",
        "category": "FlowFile",
        "advanced": false,
        "configDescriptors": {
            "do": {
                "name": "do",
                "valueType": "Policy",
                "isList": true,
                "isRequired": true,
                "assignedContextObjects": {
                    "flowfile": [
                        "org.apache.nifi.flowfile.FlowFile"
                    ]
                },
                "policyResultType": [
                    "void"
                ],
                "isHidden": false,
                "description": "Policies to run for each FlowFile."
            },
            "batch-size": {
                "name": "batch-size",
                "valueType": "Number",
                "isList": false,
                "isRequired": false,
                "defaultJson": 100,
                "isHidden": false,
                "description": "Maximum number of FlowFiles to process per trigger; 0 for all available."
            },
            "terminal-relationship": {
                "name": "terminal-relationship",
                "valueType": "String",
                "isList": false,
                "isRequired": false,
                "defaultJson": "success",
                "isHidden": false,
                "description": "Relationship an unresolved FlowFile is transferred to after 'do'. Empty or 'none' leaves it for an inner policy to resolve.",
                "isRelationship": true
            }
        },
        "requiredContextObjects": {
        },
        "resultType": [
            "void"
        ]
    },
