    "orchestrate": {
        "displayName": "orchestrate",
        "description": "Drives a FlowFile through an ordered set of steps (each a sub-flow reached by a relationship that routes back to this processor), tracking progress via wf.* attributes, until all steps are done (on-complete), an exception is seen (on-exception), or the iteration guard trips (on-loop-limit).",
        "category": "Orchestration",
        "advanced": false,
        "configDescriptors": {
            "steps": {
                "name": "steps",
                "valueType": "Group",
                "isList": true,
                "isRequired": true,
                "isHidden": false,
                "description": "Ordered workflow steps; each is dispatched to its relationship until marked done on return.",
                "fields": {
                    "name": {
                        "name": "name",
                        "valueType": "String",
                        "isList": false,
                        "isRequired": true,
                        "isHidden": false,
                        "description": "Unique step name (letters, digits, _ - . :); tracked as wf.step.<name>. It keys workflow state on the FlowFile, so keep it stable - renaming a step strands in-flight FlowFiles that already carry the old wf.step.<name>."
                    },
                    "relationship": {
                        "name": "relationship",
                        "valueType": "String",
                        "isList": false,
                        "isRequired": true,
                        "isHidden": false,
                        "description": "Relationship this step is routed to (letters, digits, _ - . :); its sub-flow routes the FlowFile back here.",
                        "isRelationship": true
                    },
                    "when": {
                        "name": "when",
                        "valueType": "Policy",
                        "isList": false,
                        "isRequired": false,
                        "assignedContextObjects": {
                        },
                        "policyResultType": [
                            "java.lang.Boolean",
                            "java.lang.Object"
                        ],
                        "isHidden": false,
                        "description": "Optional condition; the step runs only when this is true."
                    }
                }
            },
            "state-prefix": {
                "name": "state-prefix",
                "valueType": "String",
                "isList": false,
                "isRequired": true,
                "defaultJson": "wf",
                "isHidden": false,
                "description": "Namespace for the workflow-state attributes (<prefix>.iter, <prefix>.current, <prefix>.step.<name>); default wf. Use a distinct namespace if more than one orchestrate acts on the same FlowFile, to avoid state collisions."
            },
            "clean-state": {
                "name": "clean-state",
                "valueType": "Boolean",
                "isList": false,
                "isRequired": false,
                "defaultJson": true,
                "isHidden": false,
                "description": "Remove the state-prefix tracking attributes before on-complete."
            },
            "on-complete": {
                "name": "on-complete",
                "valueType": "Policy",
                "isList": false,
                "isRequired": false,
                "assignedContextObjects": {
                },
                "policyResultType": [
                    "void"
                ],
                "defaultJson": {
                    "type": "transfer-flowfile",
                    "relationship": "success"
                },
                "isHidden": false,
                "description": "Policy run when all steps are complete."
            },
            "exception-attribute": {
                "name": "exception-attribute",
                "valueType": "String",
                "isList": false,
                "isRequired": false,
                "defaultJson": "idol.exception",
                "isHidden": true,
                "description": "If present on return, the current step is treated as failed and on-exception runs."
            },
            "on-exception": {
                "name": "on-exception",
                "valueType": "Policy",
                "isList": false,
                "isRequired": false,
                "assignedContextObjects": {
                },
                "policyResultType": [
                    "void"
                ],
                "defaultJson": {
                    "type": "transfer-flowfile",
                    "relationship": "failure"
                },
                "isHidden": true,
                "description": "Policy run when the exception attribute is present."
            },
            "max-iterations": {
                "name": "max-iterations",
                "valueType": "Number",
                "isList": false,
                "isRequired": false,
                "defaultJson": 100,
                "isHidden": true,
                "description": "Maximum passes before routing to on-loop-limit (guards against runaway loops)."
            },
            "on-loop-limit": {
                "name": "on-loop-limit",
                "valueType": "Policy",
                "isList": false,
                "isRequired": false,
                "assignedContextObjects": {
                },
                "policyResultType": [
                    "void"
                ],
                "defaultJson": {
                    "type": "transfer-flowfile",
                    "relationship": "failure"
                },
                "isHidden": true,
                "description": "Policy run when the iteration guard trips."
            }
        },
        "requiredContextObjects": {
            "flowfile": [
                "org.apache.nifi.flowfile.FlowFile"
            ]
        },
        "resultType": [
            "void"
        ]
    },
